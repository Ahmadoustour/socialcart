rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection - public profiles for sellers, members and accounts
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Posts Collection - public social feed accessible across all browsers
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Products Collection - marketplace items and reviews accessible across all browsers
    match /products/{productId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Conversations Collection - chat messages and inquiries between users
    match /conversations/{convId} {
      allow read, write: if true;
    }

    // Orders Collection - purchases and transactions
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
